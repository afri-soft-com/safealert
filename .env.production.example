# SafeAlert — variables de production (copier vers .env.production)
# Ne jamais committer .env.production avec de vraies clés.

# --- Serveur ---
PORT=3000
NODE_ENV=production
DOMAIN=api.votredomaine.com
CORS_ORIGIN=https://votredomaine.com

# --- Image Docker (GHCR — déploiement production) ---
# Tag poussé par .github/workflows/deploy.yml sur chaque release
API_IMAGE=ghcr.io/afri-soft-com/safealert-api:latest

# --- PostgreSQL local (docker-compose.yml — dev / VPS tout-en-un) ---
POSTGRES_DB=safealert
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Neon PostgreSQL (docker-compose.neon.yml — prod recommandé) ---
# Projet Neon : super-bread-07647037 (branche production, région aws-us-east-1)
# Rôle par défaut : neondb_owner — remplacer PASSWORD par le mot de passe du rôle (console Neon)
# URL poolée (avec -pooler) : connexions API en runtime
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-twilight-sea-apcojpgg-pooler.c-7.us-east-1.aws.neon.tech/safealert?sslmode=require
# URL directe (sans -pooler) : migrations et opérations DDL
DATABASE_URL_DIRECT=postgresql://neondb_owner:PASSWORD@ep-twilight-sea-apcojpgg.c-7.us-east-1.aws.neon.tech/safealert?sslmode=require

# --- Backend API ---
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING
JWT_EXPIRES_IN=30d

# --- Redis (conteneur Docker sur le VPS — recommandé en production) ---
# Latence faible avec l'API, pas de service managé requis.
# Alternative : Upstash Redis (REDIS_URL=rediss://...) si vous préférez un cache managé.
REDIS_URL=redis://redis:6379

# --- SMS (Twilio prioritaire, puis Africa's Talking, sinon simulation console) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# --- Firebase Cloud Messaging (backend) ---
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# --- CI/CD — secrets GitHub Actions (repo afri-soft-com/safealert) ---
# PRODUCTION_URL=https://api.votredomaine.com
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_SSH_KEY=
# DEPLOY_PATH=/opt/safealert
# COMPOSE_FILE=docker-compose.neon.yml
# DATABASE_URL et DATABASE_URL_DIRECT : aussi en secrets si migrations CI sur Neon

# --- Build mobile Flutter ---
# API_BASE_URL=https://api.votredomaine.com/api
