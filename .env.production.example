# SafeAlert — variables de production (copier vers .env.production)
# Ne jamais committer .env.production avec de vraies clés.

# --- Serveur ---
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
DOMAIN=api.votredomaine.com
# Origines autorisées (CSV). Obligatoire en production — ex. admin + site public
CORS_ORIGIN=https://admin.votredomaine.com,https://votredomaine.com

# --- Image Docker (GHCR — déploiement production) ---
# Tag poussé par .github/workflows/deploy.yml sur chaque release
API_IMAGE=ghcr.io/afri-soft-com/safealert-api:latest
# Compose file utilisé par deploy.sh / deploy.ps1
COMPOSE_FILE=docker-compose.neon.yml

# --- PostgreSQL local (docker-compose.yml — dev / VPS tout-en-un) ---
POSTGRES_DB=safealert
POSTGRES_USER=user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- PostgreSQL Render (recommandé — même région Frankfurt que l'API) ---
# Dashboard : https://dashboard.render.com → safealert-db
# Internal (API sur Render) :
DATABASE_URL=postgresql://safealert:PASSWORD@dpg-XXXX-a/safealert
DATABASE_URL_DIRECT=postgresql://safealert:PASSWORD@dpg-XXXX-a/safealert
# External (migrations depuis le PC / CI) : ajouter ?sslmode=require
# DATABASE_URL=postgresql://safealert:PASSWORD@dpg-XXXX-a.frankfurt-postgres.render.com/safealert?sslmode=require

# --- Backend API ---
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARACTERS_RANDOM_STRING
JWT_EXPIRES_IN=30d
# Promouvoir un compte existant (E.164) au rôle platform_admin lors de migrate
PLATFORM_ADMIN_PHONE=
# User-Agent Nominatim (OSM) — mettre un contact valide en prod
NOMINATIM_USER_AGENT=SafeAlert/1.0 (api.votredomaine.com; contact@votredomaine.com)
# Servir admin-web depuis l'API (optionnel) : chemin absolu vers admin-web/dist
# ADMIN_WEB_DIST=/opt/safealert/admin-web/dist

# --- Redis (conteneur Docker sur le VPS — recommandé en production) ---
# Latence faible avec l'API, pas de service managé requis.
# Alternative : Upstash Redis (REDIS_URL=rediss://...) si vous préférez un cache managé.
REDIS_URL=redis://redis:6379

# --- SMS / OTP (hub AfriSoft prioritaire, puis SerdiPay, Twilio, Africa's Talking) ---
# Sans SMS réel, l'OTP reste en simulation — inutilisable pour les utilisateurs finaux
SMS_PROVIDER=auto
AFRISOFT_SMS_HUB_URL=https://sms.afri-soft.com
AFRISOFT_HUB_APP_ID=afrisoft-partenaire
AFRISOFT_HUB_API_KEY=
SERDIPAY_API_KEY=
SERDIPAY_SMS_URL=
SERDIPAY_SENDER_ID=SafeAlert
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# --- Firebase Cloud Messaging (backend) ---
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# --- CI/CD — secrets GitHub Actions (repo afri-soft-com/safealert) ---
# PRODUCTION_URL=https://api.votredomaine.com
# DEPLOY_HOST=
# DEPLOY_USER=
# DEPLOY_SSH_KEY=
# DEPLOY_PATH=/opt/safealert
# COMPOSE_FILE=docker-compose.neon.yml
# DATABASE_URL et DATABASE_URL_DIRECT : aussi en secrets si migrations CI sur Neon

# --- Build mobile Flutter ---
# API_BASE_URL=https://api.votredomaine.com/api
# Signature Play Store : frontend/android/key.properties (voir key.properties.example)
