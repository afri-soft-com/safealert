# Server
PORT=3000
NODE_ENV=development
# Comma-separated origins in production (e.g. https://app.example.com)
CORS_ORIGIN=

# Database (local Docker : db:5432 — Neon prod : URL poolée avec ?sslmode=require)
DATABASE_URL=postgresql://user:password@localhost:5432/safealert
# DATABASE_URL_DIRECT=  # Neon uniquement : endpoint direct pour migrations

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# OTP (codes stored in DB, 5 min TTL — no extra config required)
# En dev sans Twilio/Africa's Talking : code affiché dans le terminal backend
# et renvoyé dans la réponse API (champ devCode) — jamais en production

# Twilio (SMS) — Console : Account Info (SID + Auth Token), Phone Numbers (numéro émetteur)
# Compte Trial : le destinataire doit être dans Verified Caller IDs (+243 en E.164, ex. +243812345678)
# Geo permissions : Messaging → Settings → activer Congo (RDC) si l'envoi échoue
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Africa's Talking (alternative SMS)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Firebase Cloud Messaging (compte de service — voir docs/FIREBASE_SETUP.md)
# Alias acceptés : FIREBASE_PROJECT_ID, FIREBASE_PRIVATE_KEY, FIREBASE_CLIENT_EMAIL
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# Redis (optional, for active alert cache)
REDIS_URL=
