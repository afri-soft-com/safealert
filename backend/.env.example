# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development
# Comma-separated origins in production (e.g. https://app.example.com,https://admin.example.com)
# Obligatoire en production (ou *). Dev : localhost:5173 autorisé automatiquement pour admin-web
CORS_ORIGIN=

# Console admin web — promouvoir un compte existant au rôle platform_admin
PLATFORM_ADMIN_PHONE=

# Géocodage inverse OSM Nominatim (recommandé en prod avec email de contact)
NOMINATIM_USER_AGENT=SafeAlert/1.0 (local-dev; contact@example.com)

# Servir le build admin-web depuis l'API (optionnel, chemin vers admin-web/dist)
# ADMIN_WEB_DIST=../admin-web/dist

# Database (local Docker : localhost:5433 — prod : Postgres Render)
DATABASE_URL=postgresql://user:password@localhost:5432/safealert
# Sur Render : DATABASE_URL = connectionString interne du service safealert-db
# DATABASE_URL_DIRECT=  # même URL sur Render (pas de pooler Neon)

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# OTP (codes stored in DB, 5 min TTL — no extra config required)
# En dev sans hub SMS : code affiché dans le terminal backend
# et renvoyé dans la réponse API (champ devCode).
#
# Bypass temporaire (tests admin sans SMS fiable) — JAMAIS par défaut :
# ALLOW_DEV_OTP=true  (alias : OTP_BYPASS_ENABLED=true)
# → code aléatoire loggé ([DEV OTP] via console.warn) + champ JSON devCode
#   même si NODE_ENV=production (et même si des clés SMS sont présentes).
# OTP_BYPASS_CODE=123456  # optionnel : code fixe à 6 chiffres (sinon aléatoire)
# DÉSACTIVER (supprimer ALLOW_DEV_OTP) dès que le hub AfriSoft livre les SMS.
# ALLOW_DEV_OTP=false

# Fournisseur SMS prioritaire : auto | afrisoft | serdipay | twilio | africastalking
SMS_PROVIDER=auto

# Hub AfriSoft SMS (OTP RDC — priorité en mode auto)
# SafeAlert génère/stocke/vérifie l'OTP ; le hub n'envoie que le SMS.
# Clé : dashboard Render / .env local — jamais Git.
AFRISOFT_SMS_HUB_URL=https://sms.afri-soft.com
AFRISOFT_HUB_APP_ID=afrisoft-partenaire
AFRISOFT_HUB_API_KEY=

# SerdiPay direct (secours — préférer le hub ci-dessus)
SERDIPAY_API_KEY=
SERDIPAY_SMS_URL=
SERDIPAY_SENDER_ID=SafeAlert
# Auth header : Bearer (défaut) ou apiKey
# SERDIPAY_API_KEY_HEADER=apiKey

# Twilio (SMS) — secours si SerdiPay indisponible
# Compte Trial : destinataire dans Verified Caller IDs (+243 en E.164)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Africa's Talking (alternative SMS)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Firebase Cloud Messaging (compte de service — voir docs/FIREBASE_SETUP.md)
# Alias acceptés : FIREBASE_PROJECT_ID, FIREBASE_PRIVATE_KEY, FIREBASE_CLIENT_EMAIL
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# Version mobile + console admin (GET /api/app/version) — bannière de mise à jour
# Doit être identique à la version livrée (pubspec avant +build) pour que la bannière disparaisse après install
APP_LATEST_VERSION=1.0.10
# APP_MIN_VERSION=1.0.0
# APP_FORCE_UPDATE=false
# APP_STORE_URL=https://play.google.com/store/apps/details?id=com.safealert.safealert
ADMIN_WEB_VERSION=1.0.4
# ADMIN_WEB_URL=https://safealert-admin.onrender.com

# Redis (optional, for active alert cache)
REDIS_URL=
