# Server
PORT=3000
NODE_ENV=development
# Comma-separated origins in production (e.g. https://app.example.com)
CORS_ORIGIN=

# Database (local Docker : db:5432 — Neon prod : URL poolée avec ?sslmode=require)
DATABASE_URL=postgresql://user:password@localhost:5432/safealert
# DATABASE_URL_DIRECT=  # Neon uniquement : endpoint direct pour migrations

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=30d

# OTP (codes stored in DB, 5 min TTL — no extra config required)
# In dev/test, codes are logged to console when SMS is not configured

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Africa's Talking (alternative SMS)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=

# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# Redis (optional, for active alert cache)
REDIS_URL=
